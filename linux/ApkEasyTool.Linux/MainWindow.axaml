<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApkEasyTool.Linux.MainWindow"
        Width="1180" Height="800" MinWidth="940" MinHeight="660"
        Title="APK Easy Tool">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="230,*" Margin="22">
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="3">
        <TextBlock Text="APK Easy Tool" FontSize="27" FontWeight="Bold"/>
        <TextBlock Text="Android package workspace" Opacity="0.68"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Appearance" VerticalAlignment="Center" Opacity="0.75"/>
        <ComboBox x:Name="ThemeSelector" Width="132" SelectedIndex="0">
          <ComboBoxItem Content="System"/>
          <ComboBoxItem Content="Light"/>
          <ComboBoxItem Content="Dark"/>
        </ComboBox>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.Column="0" Padding="14" CornerRadius="12"
            BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <StackPanel x:Name="WorkflowPanel" Spacing="8">
        <TextBlock Text="WORKSPACE ACTIONS" FontWeight="Bold" FontSize="11" Opacity="0.65" Margin="2,0,0,8"/>
        <Button Content="Select APK" HorizontalContentAlignment="Left" Click="ChooseApk_Click"/>
        <Button Content="Select project" HorizontalContentAlignment="Left" Click="ChooseProject_Click"/>
        <Separator Margin="0,6"/>
        <TextBlock Text="APK WORKFLOWS" FontWeight="Bold" FontSize="11" Opacity="0.65" Margin="2,0,0,4"/>
        <Button Content="Decode APK" HorizontalContentAlignment="Left" Click="Decode_Click"/>
        <Button Content="Build / Rebuild" HorizontalContentAlignment="Left" Click="Build_Click"/>
        <Button Content="Sign APK" HorizontalContentAlignment="Left" Click="Sign_Click"/>
        <Button Content="Zipalign APK" HorizontalContentAlignment="Left" Click="ZipAlign_Click"/>
        <Button Content="Verify alignment" HorizontalContentAlignment="Left" Click="VerifyAlignment_Click"/>
        <Button Content="Install on device" HorizontalContentAlignment="Left" Click="Install_Click"/>
        <Button Content="APK information" HorizontalContentAlignment="Left" Click="ApkInfo_Click"/>
        <Button Content="Extract .apks bundle" HorizontalContentAlignment="Left" Click="ExtractBundle_Click"/>
        <Separator Margin="0,6"/>
        <TextBlock Text="OUTPUT FOLDER" FontWeight="Bold" FontSize="11" Opacity="0.65" Margin="2,0,0,0"/>
        <TextBlock Text="Documents/APKEasyTool" TextWrapping="Wrap" FontSize="12" Opacity="0.8"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="18,0,0,0">
      <StackPanel Spacing="3">
        <TextBlock Text="Workspace" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="Choose an input, then run an operation. Results are organised automatically." Opacity="0.68" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="1" Padding="16" Margin="0,14,0,14" CornerRadius="12"
              BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Current selections" FontWeight="SemiBold"/>
          <TextBox x:Name="ApkPathBox" Watermark="No APK selected" />
          <TextBox x:Name="ProjectPathBox" Watermark="No Apktool project selected" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Browse APK…" Click="ChooseApk_Click"/>
            <Button Content="Browse project…" Click="ChooseProject_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Padding="16" CornerRadius="12"
              BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Activity" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Opacity="0.7"/>
            </StackPanel>
            <Button x:Name="ClearLogButton" Grid.Column="1" Content="Clear log" Click="ClearLog_Click"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,12">
            <ProgressBar x:Name="OperationProgress" Height="7" IsVisible="False" IsIndeterminate="True" VerticalAlignment="Center"/>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel operation" IsVisible="False"
                    IsEnabled="False" Margin="12,0,0,0" Click="CancelOperation_Click"/>
          </Grid>
          <TextBox x:Name="OutputBox" Grid.Row="2" AcceptsReturn="True" IsReadOnly="True"
                   TextWrapping="Wrap" FontFamily="monospace"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" MinHeight="220"/>
        </Grid>
      </Border>

      <TextBlock Grid.Row="3" Text="Linux edition · Original project by Evildog1" Opacity="0.6" FontSize="11" Margin="2,12,0,0"/>
    </Grid>
  </Grid>
</Window>
