<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApkEasyTool.Linux.MainWindow"
        Width="1100" Height="760" MinWidth="900" MinHeight="620"
        Title="APK Easy Tool">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*" Margin="18">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="APK Easy Tool" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Linux edition · APK workflow manager" Opacity="0.7"/>
    </StackPanel>
    <Border Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="WORKFLOWS" FontWeight="Bold" Margin="4,0,0,8"/>
        <Button Content="Choose APK" Click="ChooseApk_Click"/>
        <Button Content="Choose project" Click="ChooseProject_Click"/>
        <Separator/>
        <Button Content="Decode APK" Click="Decode_Click"/>
        <Button Content="Build APK" Click="Build_Click"/>
        <Button Content="Sign APK" Click="Sign_Click"/>
        <Button Content="Zipalign APK" Click="ZipAlign_Click"/>
        <Button Content="Verify alignment" Click="VerifyAlignment_Click"/>
        <Button Content="Install APK" Click="Install_Click"/>
        <Button Content="APK information" Click="ApkInfo_Click"/>
        <Button Content="Extract .apks bundle" Click="ExtractBundle_Click"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="18,0,0,0">
      <TextBlock Text="Workspace" FontSize="22" FontWeight="SemiBold"/>
      <Border Grid.Row="1" Padding="14" Margin="0,14,0,14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Selected APK / project" FontWeight="SemiBold"/>
          <TextBox x:Name="ApkPathBox" Watermark="Select an APK file…" />
          <TextBox x:Name="ProjectPathBox" Watermark="Select an Apktool project directory…" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Browse APK" Click="ChooseApk_Click"/>
            <Button Content="Browse project" Click="ChooseProject_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Operation output" FontWeight="SemiBold"/>
            <Button Content="Clear" Click="ClearLog_Click"/>
          </StackPanel>
          <TextBox x:Name="OutputBox" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True"
                   TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="260"/>
        </Grid>
      </Border>
      <TextBlock Grid.Row="3" Text="Linux edition · Original project by Evildog1" Opacity="0.65" Margin="0,12,0,0"/>
    </Grid>
    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="APK Easy Tool Linux port" Opacity="0.6" Margin="0,14,0,0"/>
  </Grid>
</Window>
