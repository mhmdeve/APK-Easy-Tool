<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApkEasyTool.Linux.MainWindow"
        Width="1100" Height="760"
        MinWidth="900" MinHeight="620"
        Title="APK Easy Tool">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="220,*" Margin="18">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="APK Easy Tool" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Linux edition · APK workflow manager" Opacity="0.7"/>
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="WORKFLOWS" FontWeight="Bold" Margin="4,0,0,8"/>
        <Button Content="Decode APK" HorizontalAlignment="Stretch"/>
        <Button Content="Build APK" HorizontalAlignment="Stretch"/>
        <Button Content="Sign APK" HorizontalAlignment="Stretch"/>
        <Button Content="Zipalign APK" HorizontalAlignment="Stretch"/>
        <Button Content="Install APK" HorizontalAlignment="Stretch"/>
        <Button Content="APK information" HorizontalAlignment="Stretch"/>
        <Button Content="Tool settings" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="18,0,0,0">
      <TextBlock Text="Workspace" FontSize="22" FontWeight="SemiBold"/>
      <Border Grid.Row="1" Padding="14" Margin="0,14,0,14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="10">
          <TextBlock Text="Selected APK / project" FontWeight="SemiBold"/>
          <TextBlock Text="Choose an APK or an Apktool project to get started." Opacity="0.7"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Choose APK"/>
            <Button Content="Choose project"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="Output" FontWeight="SemiBold"/>
          <TextBlock Text="Operation output and progress will appear here." Opacity="0.7"/>
          <TextBox AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="260"/>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="3" Text="Linux port is being built in stages. Check PROGRESS.md for current implementation status." Opacity="0.65" Margin="0,12,0,0"/>
    </Grid>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Original project by Evildog1 · Linux port" Opacity="0.6" Margin="0,14,0,0"/>
  </Grid>
</Window>
